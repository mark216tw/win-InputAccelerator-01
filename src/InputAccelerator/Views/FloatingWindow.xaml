<Window
    x:Class="InputAccelerator.Views.FloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:InputAccelerator.Helpers"
    xmlns:vm="using:InputAccelerator.ViewModels">

    <Grid
        x:Name="RootGrid"
        MinWidth="0"
        MinHeight="0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Border
            x:Name="WindowBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid x:Name="ExpandedView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <helpers:FloatingToolbarPanel
                        Grid.Row="0"
                        Padding="4,1,4,1"
                        HorizontalSpacing="4"
                        VerticalSpacing="2">
                        <Button
                            x:Name="OpenMainButton"
                            Width="20"
                            Height="20"
                            Click="OnOpenMainClick"
                            Style="{StaticResource FloatingIconButtonStyle}">
                            <FontIcon
                                x:Name="OpenMainIcon"
                                FontSize="10"
                                Foreground="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                Glyph="&#xE713;" />
                        </Button>

                        <ItemsControl
                            x:Name="CategoryHost"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CategoryBarVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:WrapPanel HorizontalSpacing="4" VerticalSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FloatingCategoryOptionViewModel">
                                    <Button
                                        MinWidth="0"
                                        Padding="6,1"
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Background="{x:Bind Background, Mode=OneWay}"
                                        BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                        Click="OnCategoryClick"
                                        CornerRadius="8"
                                        Style="{StaticResource FloatingChipButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind Label}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{x:Bind Foreground, Mode=OneWay}"
                                            Text="{x:Bind Label}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Border
                                x:Name="DragHandle"
                                Width="28"
                                Height="20"
                                Background="Transparent"
                                PointerCaptureLost="OnDragHandlePointerCaptureLost"
                                PointerMoved="OnDragHandlePointerMoved"
                                PointerPressed="OnDragHandlePointerPressed"
                                PointerReleased="OnDragHandlePointerReleased">
                                <FontIcon
                                    x:Name="DragIndicator"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    Glyph="&#xE7C2;" />
                            </Border>

                            <Button
                                x:Name="CollapseButton"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Click="OnCollapseClick"
                                Style="{StaticResource FloatingIconButtonStyle}">
                                <FontIcon
                                    x:Name="CollapseIcon"
                                    FontSize="10"
                                    Foreground="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    Glyph="&#xE921;" />
                            </Button>
                        </StackPanel>
                    </helpers:FloatingToolbarPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer
                            Padding="6,0,6,4"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto">
                            <ItemsControl x:Name="ChipHost" Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FloatingEntryItemViewModel">
                                        <Button
                                            MaxWidth="220"
                                            AutomationProperties.Name="{x:Bind Preview, Mode=OneWay}"
                                            Background="{x:Bind ChipBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind ChipBorder, Mode=OneWay}"
                                            Click="OnEntryClick"
                                            Style="{StaticResource FloatingChipButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind Entry.ToolTipText, Mode=OneWay}">
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                                    Glyph="&#xE765;"
                                                    Visibility="{x:Bind Entry.HotkeyVisibility, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                                    Text="{x:Bind Preview, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="EmptyStateText"
                            x:Uid="FloatingEmpty"
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>

                <Button
                    x:Name="CollapsedBlock"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="0"
                    Click="OnRestoreClick"
                    CornerRadius="8"
                    Style="{StaticResource FloatingChipButtonStyle}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CollapsedIcon"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="字" />
                </Button>
            </Grid>
        </Border>

        <Grid
            x:Name="ResizeGrip"
            Width="18"
            Height="18"
            Margin="0,0,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            PointerCaptureLost="OnResizeGripPointerCaptureLost"
            PointerMoved="OnResizeGripPointerMoved"
            PointerPressed="OnResizeGripPointerPressed"
            PointerReleased="OnResizeGripPointerReleased">
            <Path
                x:Name="ResizeGripPath"
                Width="9"
                Height="9"
                Margin="0,0,3,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Data="M0,9 L9,0 M3,9 L9,3 M6,9 L9,6"
                Opacity="0.6"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                StrokeThickness="1" />
        </Grid>
    </Grid>
</Window>
